{
  "name": "@nandoblanco/opencode-local-memory",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Local-first, automatic persistent memory plugin for OpenCode with per-turn semantic recall, atomic fact storage, session compaction checkpoints, and a zero-token /memory TUI popup.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./server": "./index.js",
    "./tui": "./tui.ts",
    "./rpc": "./rpc.js",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "bin": {
    "opencode-local-memory": "index.js"
  },
  "files": [
    "index.js",
    "rpc.js",
    "rpc.d.ts",
    "tui.ts",
    "gui.tsx",
    "gui.css",
    "dist/gui-experimental.cjs",
    "assets/screenshot.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build:gui": "vite build",
    "test": "node --no-warnings --test test/memory.test.js"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "memory",
    "persistent-memory",
    "embeddings",
    "local-first",
    "zero-token",
    "tui",
    "transformers"
  ],
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "onnxruntime-common": "1.30.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=2.0.0",
    "@opentui/core": "*",
    "@opentui/solid": "*",
    "solid-js": "*"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "overrides": {
    "glob": "14.0.5",
    "minimatch": "11.0.8"
  },
  "author": "nandoblanco",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nandoblanco/opencode-local-memory.git"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.2.5",
    "@opencode/theme": "^2.2.5",
    "solid-js": "^1.9.18",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.15"
  }
}
