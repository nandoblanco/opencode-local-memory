{
  "name": "@nandoblanco/opencode-local-memory",
  "version": "1.1.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Local-first, automatic persistent memory plugin for OpenCode with per-turn semantic recall, atomic fact storage, session compaction checkpoints, and a zero-token /memory TUI popup.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./server": "./index.js",
    "./tui": "./tui.ts"
  },
  "bin": {
    "opencode-local-memory": "index.js"
  },
  "files": [
    "index.js",
    "tui.ts",
    "assets/screenshot.png",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --no-warnings --test test/memory.test.js"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "memory",
    "persistent-memory",
    "embeddings",
    "local-first",
    "zero-token",
    "tui",
    "transformers"
  ],
  "dependencies": {
    "@xenova/transformers": "^2.17.2"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=2.0.0",
    "@opentui/core": "*",
    "@opentui/solid": "*",
    "solid-js": "*"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "author": "nandoblanco",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nandoblanco/opencode-local-memory.git"
  }
}
